{
  "name": "@sw-lplk/config-manager",
  "version": "1.0.0",
  "description": "Hierarchical config loader for Node.js — per-env sections, cross-references, .env loading",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepublishOnly": "npm test",
    "prepare": "npm run build"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "require": "./dist/env.js",
      "default": "./dist/env.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SW-lplk/config-manager-pkg.git"
  },
  "keywords": [
    "config",
    "configuration",
    "dotenv",
    "env"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}